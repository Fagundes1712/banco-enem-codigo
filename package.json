{
  "name": "banco-enem",
  "private": true,
  "description": "Simulados do ENEM com as provas oficiais 2015–2025 (HTML/CSS/JS puro).",
  "scripts": {
    "start": "python3 -m http.server 8765",
    "test": "node --test test/unidade.test.cjs && node test/dom.test.cjs && node test/guarda.test.cjs",
    "check": "node scripts/check.cjs",
    "lint": "biome lint && node scripts/knip.cjs",
    "e2e": "playwright test",
    "mutacao": "stryker run",
    "mirror": "node scripts/mirror.cjs",
    "verify": "npm run check && npm run lint && npm test",
    "pos-deploy": "node scripts/pos-deploy.cjs",
    "commits": "commitlint --from origin/main --to HEAD"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "jsdom": "^29.1.1",
    "knip": "6.43.0",
    "monocart-coverage-reports": "3.1.0"
  }
}
