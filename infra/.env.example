# Copie para infra/.env no servidor e deixe só o dono ler: chmod 600 infra/.env. Nunca commite o .env.
# Senhas: python3 -c "import secrets; print(secrets.token_urlsafe(32))" (só letras, números, - e _, porque entram em URL).

SENHA_POSTGRES=
SENHA_APP=
SENHA_MIGRACAO=
SENHA_REDIS=
SENHA_PAINEL=

# 32+ caracteres aleatórios.
JWT_SECRET=
# Endereço do site, com https.
SITE_URL=https://seudominio.com.br
# Domínio dos cookies: site e API no mesmo domínio.
COOKIE_DOMAIN=.seudominio.com.br
TURNSTILE_SECRET=
RESEND_API_KEY=
# Com aspas: os scripts também leem este arquivo.
EMAIL_REMETENTE="Banco ENEM <nao-responda@seudominio.com.br>"
# Escopos só de CHECKOUT e PRODUCT (ver api/.env.example).
ABACATEPAY_API_KEY=
# Precisa ser false: em produção a API recusa o Modo Teste.
ABACATEPAY_DEV_MODE=false
# 16+ caracteres aleatórios.
ABACATEPAY_WEBHOOK_SECRET=
# Segredo que a Cloudflare acrescenta em todo pedido (Transform Rule, cabeçalho X-Origem).
ORIGEM_SECRET=

# Painel. E-mail vazio deixa desligado. Time e AUD vêm do aplicativo no Cloudflare Access.
PAINEL_EMAIL=
PAINEL_URL=https://painel.seudominio.com.br
PAINEL_ACCESS_TIME=
PAINEL_ACCESS_AUD=
# python3 -c "import base64,secrets; print(base64.b32encode(secrets.token_bytes(20)).decode())"; cadastre no autenticador.
PAINEL_TOTP=

# Para onde vão os alertas de segurança e de falha.
ALERTA_EMAIL=

# Backup. Chave: age-keygen no seu PC. A pública vem aqui; a privada nunca entra no servidor (ver README).
BACKUP_CHAVE_PUBLICA=
BACKUP_DESTINO=r2:banco-enem-backup
# R2: chave com permissão só neste bucket.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://SUA-CONTA.r2.cloudflarestorage.com
RCLONE_S3_NO_CHECK_BUCKET=true
