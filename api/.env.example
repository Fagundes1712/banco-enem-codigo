# Copie para .env (o Git ignora) e preencha. Em produção, use os segredos do Cloud Run, nunca um arquivo.

# dev (sua máquina), teste (pytest) ou producao
AMBIENTE=dev
# PostgreSQL. No Neon, use o endereço com "-pooler".
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/bancoenem
# Redis (Upstash: endereço rediss://). Obrigatório em produção; vazio = contador na memória.
REDIS_URL=
# 32+ caracteres aleatórios: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Endereço do site (CORS, links dos e-mails e volta do pagamento). Em produção, https.
SITE_URL=http://localhost:8765
# Domínio dos cookies em produção, ex.: .seudominio.com.br (site e API no mesmo domínio). Vazio no dev.
COOKIE_DOMAIN=
# Turnstile (Cloudflare). Chave de teste que sempre aprova: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Resend. Vazio no dev: o e-mail aparece no terminal em vez de ser enviado.
RESEND_API_KEY=
EMAIL_REMETENTE=Banco ENEM <nao-responda@seudominio.com.br>
# AbacatePay: chave API v2, escopo Personalizado, só CHECKOUT:CREATE, CHECKOUT:READ, PRODUCT:CREATE, PRODUCT:READ.
ABACATEPAY_API_KEY=
# true com chave do Modo Teste; false em produção.
ABACATEPAY_DEV_MODE=true
# 16+ caracteres aleatórios; vai na URL do webhook cadastrada na AbacatePay.
ABACATEPAY_WEBHOOK_SECRET=
# Produção: segredo que a Cloudflare acrescenta em todo pedido (Transform Rule, cabeçalho X-Origem).
# Sem ele a API recusa, e ninguém fala com o endereço do Cloud Run pulando a Cloudflare.
ORIGEM_SECRET=
